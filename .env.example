# ADX admin console — every name the code reads (src/lib/api-config.ts and
# scripts/with-env.js). Copy to .env and fill in; secrets never go here.
# Next.js bakes every NEXT_PUBLIC_* value into the build: on Render or Vercel
# set them BEFORE the build, and rebuild after changing one.
# Production values and the names that must match another app's:
# PRODUCTION-ENV.md at the monorepo root. `node scripts/env-audit.mjs` (from
# the monorepo root) compares .env with this file by NAME only.

# The port `npm run dev` / `npm start` binds (scripts/with-env.js). Keep 5173
# locally: the backend's FRONTEND_URL and INVITE_ACCEPT_URL point at it.
# On Render/Vercel leave it unset — the host sets PORT itself.
PORT=5173

# Must be "true" for anything to work: with it off, every screen behind the
# login says the API is off and the login page cannot sign anybody in.
# Required in production: true.
NEXT_PUBLIC_USE_API=true

# The ADX backend's API address. Required in production. Must be the backend's
# BASE_URL + /api/v1 — the same value as the website's NEXT_PUBLIC_API_BASE_URL
# and the apps' RELEASE_API_BASE_URL. Render: https://adx-backendv1.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Where the website is served — Content › Pages opens Studio at
# ${NEXT_PUBLIC_SITE_URL}/studio/... Required in production (https://adx.in).
# Same value as the website's own NEXT_PUBLIC_SITE_URL and the backend's
# PUBLIC_WEB_URL. Blank falls back to the website's dev server.
NEXT_PUBLIC_SITE_URL=http://localhost:5174

# Google sign-in ("Continue with Google Workspace"): the OAuth WEB client id.
# Must be the same value as the backend's GOOGLE_CLIENT_ID — it is the audience
# the backend pins, so a different id rejects every sign-in. Optional: blank
# hides the button. From Google Cloud Console › APIs & Services › Credentials.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Cloudflare Turnstile SITE key (public) for the login and forgot-password
# forms. Set it together with the backend's TURNSTILE_SECRET_KEY from the same
# Turnstile widget — one without the other either shows a widget nobody checks
# or has the backend refuse every console sign-in. Blank hides the widget.
# From the Cloudflare dashboard › Turnstile. Read PRODUCTION-ENV.md before
# setting the pair: the website and the apps do not send a token yet.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
